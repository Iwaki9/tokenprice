# Пароль в админку /ru/admin. Обязательно задайте перед деплоем.
ADMIN_PASSWORD=change-me

# Секрет для подписи cookie админки. Если не задан — выводится из ADMIN_PASSWORD.
# ADMIN_SECRET=random-64-chars

# Каталог данных (по умолчанию ./data)
# DATA_DIR=./data

# Курсы для краулера (по умолчанию курс ЦБ РФ на 10.11.2026: USD 82.7536 ₽, CNY 12.3098 ₽)
# FX_CNY_USD=0.1487
# FX_RUB_USD=0.01208

# API-ключи провайдеров для health-проб: TR_KEY_<SLUG>
# TR_KEY_SWIFTROUTE=sk-...
